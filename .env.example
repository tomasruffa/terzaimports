# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@terzaimports.com.ar
ADMIN_PASSWORD=change-me

# API (Railway inyecta PORT automáticamente)
API_PORT=4000
API_PUBLIC_URL=https://terzaapi-production.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-app.vercel.app,https://your-admin.up.railway.app

# Railway Bucket (S3-compatible) — imágenes de productos
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=https://your-bucket-name.t3.storageapi.dev

# Mercado Libre (developers.mercadolibre.com.ar)
# Redirect URI en la app debe ser exactamente: {API_PUBLIC_URL}/api/mercadolibre/callback
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://terzaapi-production.up.railway.app/api/mercadolibre/callback

# Next.js (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase Analytics (apps/web — config pública del cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
