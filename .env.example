# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@terzaimports.com.ar
ADMIN_PASSWORD=change-me

# API (Railway inyecta PORT automáticamente)
API_PORT=4000
API_PUBLIC_URL=https://terzaapi-production.up.railway.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-app.vercel.app,https://your-admin.up.railway.app

# Railway Bucket (S3-compatible) — imágenes de productos (privado; se sirven vía API /api/storage)
S3_ENDPOINT=https://t3.storageapi.dev
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
API_PUBLIC_URL=https://terzaapi-production.up.railway.app

# Mercado Libre (developers.mercadolibre.com.ar)
# Redirect URI en la app debe ser exactamente: {API_PUBLIC_URL}/api/mercadolibre/callback
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://terzaapi-production.up.railway.app/api/mercadolibre/callback
# Secret opcional para cron de refresh: POST /api/mercadolibre/refresh-tokens con header x-cron-secret
MELI_CRON_SECRET=

# Kapso — alertas WhatsApp (Integrations → API keys + WhatsApp → Phone numbers)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Número admin: 54 + área + número, sin el 9 móvil (ej: 541138033513)
ADMIN_WHATSAPP_NUMBER=
# Template UTILITY aprobado en Meta para ventas fuera de ventana 24h
KAPSO_SALE_TEMPLATE=terza_nueva_venta
KAPSO_SALE_TEMPLATE_LANG=es_AR

# Horas entre alertas de stock bajo por producto (default: 24)
LOW_STOCK_NOTIFY_COOLDOWN_HOURS=24

# Next.js (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase Analytics (apps/web — config pública del cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
